# epiweather-web 환경변수 예시
# .env.local로 복사해서 사용.

# 배포된 백엔드(epiweather-api) URL. 비우면 http://localhost:8000으로 폴백.
NEXT_PUBLIC_API_URL=

# 서버 전용 백엔드 키 (2026-11-02 도입). NEXT_PUBLIC_* 으로 두지 말 것.
# 인증 필요 호출은 Next 라우트(src/app/api/**)가 이 키로 백엔드에 프록시한다.
# 브라우저 번들에는 절대 포함되지 않는다.
EPIWEATHER_API_KEY=

# 서버가 호출할 백엔드 주소. 비우면 NEXT_PUBLIC_API_URL → localhost:8000 순 폴백.
EPIWEATHER_API_URL=
