# epiweather-web 환경변수 예시
# .env.local로 복사해서 사용.

# 배포된 백엔드(epiweather-api) URL. 비우면 http://localhost:8000으로 폴백.
NEXT_PUBLIC_API_URL=

# ⚠️ 운영(Vercel)에는 채우지 말 것 — 2026-08-19 기준 비어 있고, 그게 맞다.
#
# NEXT_PUBLIC_* 는 빌드타임에 브라우저 번들로 그대로 박힌다. 즉 여기 넣는 값은
# 누구나 개발자도구로 꺼내볼 수 있다. 예전엔 "쓰기 몇 개만 막는 최소 게이트"라
# 감수할 만했지만, 이제 같은 키가 **돈이 나가는 엔드포인트**도 지킨다:
#   /api/global-watch   (Perplexity + Tavily + Claude)
#   /api/threats/semantic (Claude)
# 여기 서버 키를 채우면 누구든 이 둘을 무한 호출해 크레딧을 뺄 수 있다.
#
# 로컬 개발에서 대시보드 쓰기를 시험할 때만 .env.local 에 넣고, 운영에는 두지 않는다.
# 운영에서 쓰기가 필요해지면 src/lib/api.ts 상단 주석의 ①(서버 라우트 프록시) 또는
# ②(쓰기 전용 저권한 키)로 간다.
NEXT_PUBLIC_API_KEY=
