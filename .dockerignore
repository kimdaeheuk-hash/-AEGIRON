# Railway API 이미지 빌드 제외 목록 (2026-10-29)
# .dockerignore가 없어 .env 실키·data 65MB·node_modules 453MB가 통째로
# 이미지와 빌드 컨텍스트에 들어가고 있었다. 아래는 포함 금지 목록이다.

# ★ 시크릿·데이터 — 이미지에 절대 포함 금지 ★
epiweather-api/.env*
epiweather-api/data/

# 캐시·테스트 산출물
epiweather-api/__pycache__/
epiweather-api/**/__pycache__/
epiweather-api/.pytest_cache/

# API 이미지에 불필요한 대용량 경로
# (epiweather-handoff는 main.py가 sys.path로 import하므로 제외 금지)
epiweather-web/
.git/
