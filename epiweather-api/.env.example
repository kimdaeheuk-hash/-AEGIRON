# epiweather-api 환경변수 예시
# 실제 값을 채운 뒤 .env로 복사해서 사용 (.env는 .gitignore로 커밋 제외됨).
#
# 2026-11-22 정리: 개편 뒤 코드가 실제로 읽는 이름만 남겼다. 운영(Railway)에서도
# 안 쓰는 열쇠 16개(AI·뉴스·기상청·질병청·텔레그램 등)를 지웠다.

# ── 필수: 쓰기(POST) 엔드포인트 인증 ──────────────────────────
# 설정 안 하면 모든 POST 엔드포인트가 503으로 막힘(fail-closed).
# openssl rand -hex 32 등으로 임의 문자열 생성해서 사용.
EPIWEATHER_API_KEY=

# 선택: 고객사/파트너별로 키를 따로 발급하고 싶을 때 "라벨:키" 쌍을 쉼표로
# 나열. EPIWEATHER_API_KEY(위)는 label="default"로 계속 같이 동작함.
# 예: EPIWEATHER_API_KEYS=partner_a:xxxx,internal_dashboard:yyyy
EPIWEATHER_API_KEYS=

# ── CORS: 배포된 프론트엔드 도메인 (쉼표로 구분) ──────────────
ALLOWED_ORIGINS=

# ── 식약처 (선택) — 발할라 공백 지도 '국내 허가' 칸 ──────────────
# 공공데이터포털 '식품의약품안전처_의약품 제품 허가정보' 활용신청 키(일반 인증키 Decoding 권장).
# 없으면 국내 허가 칸이 전부 판정 안 함. 규약: algorithms/reference_fetch.fetch_domestic_products
MFDS_API_KEY=

# ── NVIDIA (선택) — 헤임달 심화 분석 ──────────────────────────
# NVIDIA_API_KEY 하나로 Evo2 유전체 자연스러움·ColabFold MSA 상동성이 동작한다.
# 없으면 그 두 심화 분석만 꺼지고 기본 스크리닝은 그대로. 규약: algorithms/nvidia.py
NVIDIA_API_KEY=
# (선택) 온프렘 NIM 클러스터 — 설정하면 유전체 층이 NVIDIA 클라우드 대신 여기로 간다.
AEGIRON_NVIDIA_ONPREM_BASE=

# ── 헤임달 변이 추적 (선택) ───────────────────────────────────
# 감시 Nextstrain 빌드 교체. 형식 "/경로|표시명,/경로|표시명". 비우면 SARS-CoV-2 공개 빌드.
AEGIRON_VARIANT_BUILDS=

# ── 운영 스위치 ───────────────────────────────────────────────
# 로컬에서 다른 스케줄러(cron 등)를 이미 쓰고 있어 내장 스케줄러와 중복 수집하면
# 안 될 때 off.
EPIWEATHER_SCHEDULER=on
# 관측값 시계열 저장(극지 추이 등). off 면 저장하지 않는다.
EPIWEATHER_OBSERVATION_STORE=on
