# epiweather-api 환경변수 예시
# 실제 값을 채운 뒤 .env로 복사해서 사용 (.env는 .gitignore로 커밋 제외됨).

# ── 필수: 쓰기(POST) 엔드포인트 인증 ──────────────────────────
# 설정 안 하면 모든 POST 엔드포인트가 503으로 막힘(fail-closed).
# openssl rand -hex 32 등으로 임의 문자열 생성해서 사용.
EPIWEATHER_API_KEY=

# 선택: 고객사/파트너별로 키를 따로 발급하고 싶을 때 "라벨:키" 쌍을 쉼표로
# 나열. EPIWEATHER_API_KEY(위)는 label="default"로 계속 같이 동작함.
# 예: EPIWEATHER_API_KEYS=airline_partner_a:xxxx,internal_dashboard:yyyy
EPIWEATHER_API_KEYS=

# ── CORS: 배포된 프론트엔드 도메인 (쉼표로 구분) ──────────────
ALLOWED_ORIGINS=

# ── 실데이터 소스 ─────────────────────────────────────────────
KDCA_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── AI 갭필링 ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=

# ── NVIDIA (선택) — 키 규약 단일화 ────────────────────────────
# NVIDIA_API_KEY 하나로 아래 4개 NVIDIA 서비스가 전부 동작한다(코드베이스 표준):
#   · Evo2 유전체 자연스러움(evo2_naturalness)   — health.api.nvidia.com
#   · ColabFold MSA 상동성(msa_homology)         — health.api.nvidia.com
#   · PDF 표 추출(pdf_table_extract)             — NVIDIA NIM
#   · 뉴스→신호 텍스트 추출(aegiron_model, Phase50) — integrate.api.nvidia.com
# 발급: https://build.nvidia.com/  (Bearer 토큰). 규약 정의: algorithms/nvidia.py
NVIDIA_API_KEY=

# (선택) 텍스트 추출 '전용' 키 오버라이드 — 텍스트 NIM만 별도 쿼터/키를 쓰고
# 싶을 때만. 비우면 위 NVIDIA_API_KEY로 폴백(유전체 층과 동일 키).
AEGIRON_NIM_API_KEY=
# (선택) 텍스트 NIM 모델명(생략 시 meta/llama-3.1-8b-instruct).
# ★ 추출 품질 주의 ★ 이 태스크는 "연도가 없으면 추측하지 말고 null"·"국가가 하나로
# 특정 안 되면 null" 처럼 **모델이 참는** 능력을 요구한다. 작은 모델일수록 이걸 못
# 참고 채워 넣는다(그게 곧 허위 신호다). 8B 기본값은 '동작 확인용'으로 보고,
# 운영에서는 더 큰 NIM 모델을 지정하는 걸 권한다.
# 예: AEGIRON_NIM_MODEL=meta/llama-3.3-70b-instruct
AEGIRON_NIM_MODEL=
# (선택) 텍스트 추출만 NIM에서 빼는 스위치(on/off, 기본 on).
# NVIDIA_API_KEY는 유전체·MSA·PDF 층과 공유하는 키라서, 유전체 때문에 키를 넣으면
# 텍스트 추출 모델까지 같이 바뀐다. 유전체는 NIM으로 쓰되 추출은 기존 경로로
# 되돌리고 싶으면 off — 재배포 없이 환경변수만 바꾸면 된다.
AEGIRON_NIM_EXTRACT=on
# (선택) 텍스트 NIM base_url. 비우면 NVIDIA 호스팅(integrate.api.nvidia.com) =
# '준주권'(데이터가 NVIDIA 클라우드 경유). 온프렘/사설 GPU URL을 넣으면 텍스트
# 층만 '완전 주권'으로 표시되고 민감 데이터도 통과 가능.
# 예: AEGIRON_NIM_BASE_URL=https://nim.internal.example.gov/v1
AEGIRON_NIM_BASE_URL=

# ── 완전 주권(온프렘) — 이 하나로 전 NVIDIA 층을 온프렘으로 ───────
# 설정하면 유전체(Evo2/MSA) + 텍스트 NIM이 '전부' 이 온프렘 NIM 클러스터로
# 라우팅되어 어떤 데이터도 NVIDIA 클라우드로 나가지 않는다(sovereignty=full_onprem).
# 정부·국방 조달의 데이터 국외반출 금지 요건 대비. 위 AEGIRON_NIM_BASE_URL이
# 따로 설정돼 있으면 텍스트 층은 그쪽이 우선.
# 자체호스팅: NVIDIA NIM/BioNeMo 컨테이너를 사설 GPU에 배포(NGC 카탈로그).
# 예: AEGIRON_NVIDIA_ONPREM_BASE=https://nim.internal.aegiron.gov
AEGIRON_NVIDIA_ONPREM_BASE=

# ── 데이터 주권 게이팅(정부·국방 조달 대비) ────────────────────
# on이면 sensitive=True 데이터를 '완전 주권' 경로(자체 호스팅 NIM/로컬 모델)로만
# 처리하고, 호스팅 NIM·외부 LLM으로는 '보내기 전에' 차단(fail-closed).
AEGIRON_REQUIRE_LOCAL=off
# (선택) transformers 기반 로컬 분류기 경로. 있으면 로딩 시도.
AEGIRON_LOCAL_MODEL=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# ── 행동 신호 (Phase2) ────────────────────────────────────────
HIRA_API_KEY=
SEOUL_OPEN_DATA_KEY=

# ── 이동성/동물신호 (선택, 없어도 무료 티어로 동작) ───────────
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
WAHIS_API_KEY=

# ── 토지이용/벌목 선행지표 (선택) ─────────────────────────────
# NASA FIRMS 활성 화재 탐지 → 벌목·화전(land-clearing) 프록시. 스필오버
# 1순위 동인인 삼림파괴의 선행 신호. 없으면 /api/land-signals가 조용히
# data_available=False로 표시(다른 조회는 정상). 무료 발급:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Global Forest Watch 통합 산림손실 알림(GLAD/RADD 위성) → 화재 프록시가 아닌
# 직접 산림손실 측정. 없으면 /api/deforestation-signals가 조용히
# data_available=False. 무료 발급: https://data-api.globalforestwatch.org/
GFW_API_KEY=

# ── 실시간 알림 (선택) ────────────────────────────────────────
# critical·high 등급 신규 경보를 Telegram으로 즉시 발송. 둘 다 없으면
# 조용히 꺼진 채로 동작(대시보드 조회는 그대로 됨).
# 발급: @BotFather에게 /newbot 메시지 → 토큰 발급(무료, 30초).
# TELEGRAM_CHAT_ID: 알림 받을 개인 채팅 또는 채널 ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 스케줄러 ──────────────────────────────────────────────────
# 로컬에서 별도 작업 스케줄러(cron 등)를 이미 쓰고 있어 API 프로세스 내장
# 스케줄러와 중복 수집하면 안 될 때 off로 설정.
EPIWEATHER_SCHEDULER=on
